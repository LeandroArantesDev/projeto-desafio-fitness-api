meta {
  name: Participar de desafio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/participacoes
  body: json
  auth: inherit
}

body:json {
  {
    "desafio_id": {{desafioId}}
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("participacaoId", res.body.id);
  }
}

docs {
  O usuário do token passa a participar do desafio.
  Resposta 201 com a participação; o script guarda o id em `participacaoId`.
  400 se o desafio não existe ou se o usuário já participa.
}

assert {
  res.status: eq 201
}
